+/* Optional render-thread diagnostics, enabled with WINE_MFME_PROFILE=1. All times are in microseconds and all
+ * fields are protected by media_engine::cs. */
+struct media_engine_profile
+{
+    LONGLONG window_start;
+    LONGLONG last_tick;
+    LONGLONG last_transfer;
+    LONGLONG last_pts;
+    unsigned int ticks, ticks_with_frame;
+    unsigned int transfers, transfers_new, transfers_repeat, transfers_fast;
+    LONGLONG tick_gap_max, tick_cs_wait_max;
+    LONGLONG transfer_gap_max, transfer_cs_wait_max;
+    LONGLONG transfer_total, transfer_max;
+    LONGLONG device_wait_total, device_wait_max;
+    LONGLONG upload_total, upload_max;
+    unsigned int uploads;
+    /* GPU time of the commands issued by a transfer, measured with timestamp queries. */
+    unsigned int gpu_n, gpu_skipped;
+    LONGLONG gpu_total, gpu_max;
+    /* Per-call state, valid while TransferVideoFrame is running. */
+    BOOL cur_fast, cur_seen;
+    BOOL cur_new;
+};
+
+struct media_engine_gpu_timing
+{
+    ID3D11Query *disjoint, *start, *end;
+    BOOL pending;
+};
