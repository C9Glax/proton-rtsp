+/* Optional diagnostics, enabled with WINE_MFRW_PROFILE=1: logs one line per second about IMFSourceReader::ReadSample
+ * calls (how long they block, which thread makes them) and about samples reported through the async callback.
+ * All times are in microseconds. Aggregated over all readers in the process. */
+static CRITICAL_SECTION profile_cs;
+static CRITICAL_SECTION_DEBUG profile_cs_debug =
+{
+    0, 0, &profile_cs,
+    { &profile_cs_debug.ProcessLocksList, &profile_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": profile_cs") }
+};
+static CRITICAL_SECTION profile_cs = { &profile_cs_debug, -1, 0, 0, 0, 0 };
+
+static struct
+{
+    LONGLONG window_start, last_call, last_callback;
+    unsigned int calls, async_calls, sync_calls, callbacks, thread_changes;
+    LONGLONG sync_total, sync_max, cs_wait_max, gap_max, callback_gap_max;
+    DWORD last_tid;
+} profile;
+
+static BOOL profile_enabled(void)
+{
+    static LONG state; /* 0: unknown, 1: disabled, 2: enabled. */
+    LONG value = ReadAcquire(&state);
+
+    if (!value)
+    {
+        const char *env = getenv("WINE_MFRW_PROFILE");
+        value = env && atoi(env) > 0 ? 2 : 1;
+        InterlockedExchange(&state, value);
+    }
+
+    return value == 2;
+}
+
+static LONGLONG profile_now(void)
+{
+    static LONGLONG frequency;
+    LARGE_INTEGER counter;
+
+    if (!frequency)
+    {
+        LARGE_INTEGER freq;
+        QueryPerformanceFrequency(&freq);
+        frequency = freq.QuadPart;
+    }
+
+    QueryPerformanceCounter(&counter);
+    return counter.QuadPart * 1000000 / frequency;
+}
+
+/* Must be called with profile_cs held. */
+static void profile_flush(LONGLONG now)
+{
+    LONGLONG last_call, last_callback;
+    DWORD last_tid;
+
+    if (!profile.window_start)
+    {
+        profile.window_start = now;
+        return;
+    }
+
+    if (now - profile.window_start < 1000000)
+        return;
+
+    wine_dbg_printf("mfrw-prof: window %uus | ReadSample: n=%u async=%u sync=%u sync_avg=%uus sync_max=%uus"
+            " cs_wait_max=%uus gap_max=%uus thread_changes=%u last_tid=%04lx"
+            " | OnReadSample: n=%u gap_max=%uus\n",
+            (unsigned int)(now - profile.window_start), profile.calls, profile.async_calls, profile.sync_calls,
+            (unsigned int)(profile.sync_calls ? profile.sync_total / profile.sync_calls : 0),
+            (unsigned int)profile.sync_max, (unsigned int)profile.cs_wait_max, (unsigned int)profile.gap_max,
+            profile.thread_changes, profile.last_tid, profile.callbacks, (unsigned int)profile.callback_gap_max);
+
+    last_call = profile.last_call;
+    last_callback = profile.last_callback;
+    last_tid = profile.last_tid;
+    memset(&profile, 0, sizeof(profile));
+    profile.window_start = now;
+    profile.last_call = last_call;
+    profile.last_callback = last_callback;
+    profile.last_tid = last_tid;
+}
+
+static void profile_read_sample_done(LONGLONG start, LONGLONG end, LONGLONG cs_wait, BOOL async)
+{
+    DWORD tid = GetCurrentThreadId();
+
+    EnterCriticalSection(&profile_cs);
+
+    profile.calls++;
+    if (async)
+        profile.async_calls++;
+    else
+    {
+        LONGLONG duration = end - start;
+        profile.sync_calls++;
+        profile.sync_total += duration;
+        profile.sync_max = max(profile.sync_max, duration);
+    }
+    profile.cs_wait_max = max(profile.cs_wait_max, cs_wait);
+    if (profile.last_call)
+        profile.gap_max = max(profile.gap_max, start - profile.last_call);
+    profile.last_call = start;
+    if (profile.last_tid && profile.last_tid != tid)
+        profile.thread_changes++;
+    profile.last_tid = tid;
+
+    profile_flush(end);
+
+    LeaveCriticalSection(&profile_cs);
+}
+
+static void profile_callback_reported(void)
+{
+    LONGLONG now = profile_now();
+
+    EnterCriticalSection(&profile_cs);
+
+    profile.callbacks++;
+    if (profile.last_callback)
+        profile.callback_gap_max = max(profile.callback_gap_max, now - profile.last_callback);
+    profile.last_callback = now;
+
+    profile_flush(now);
+
+    LeaveCriticalSection(&profile_cs);
+}
