+static BOOL media_engine_profile_enabled(void)
+{
+    static LONG state; /* 0: unknown, 1: disabled, 2: enabled. */
+    LONG value = ReadAcquire(&state);
+
+    if (!value)
+    {
+        const char *env = getenv("WINE_MFME_PROFILE");
+        value = env && atoi(env) > 0 ? 2 : 1;
+        InterlockedExchange(&state, value);
+    }
+
+    return value == 2;
+}
+
+/* Returns the current time in microseconds. */
+static LONGLONG media_engine_profile_now(void)
+{
+    static LONGLONG frequency;
+    LARGE_INTEGER counter;
+
+    if (!frequency)
+    {
+        LARGE_INTEGER freq;
+        QueryPerformanceFrequency(&freq);
+        frequency = freq.QuadPart;
+    }
+
+    QueryPerformanceCounter(&counter);
+    return counter.QuadPart * 1000000 / frequency;
+}
+
+/* Enters the engine critical section, reporting how long it had to wait for it (0 if not profiling). */
+static LONGLONG media_engine_profile_enter(struct media_engine *engine)
+{
+    LONGLONG start;
+
+    if (!media_engine_profile_enabled())
+    {
+        EnterCriticalSection(&engine->cs);
+        return 0;
+    }
+
+    if (TryEnterCriticalSection(&engine->cs))
+        return 0;
+
+    start = media_engine_profile_now();
+    EnterCriticalSection(&engine->cs);
+    return media_engine_profile_now() - start;
+}
+
+static void media_engine_profile_flush(struct media_engine *engine, LONGLONG now)
+{
+    struct media_engine_profile *p = &engine->profile;
+    unsigned int frames_in = 0, queued = 0;
+    LONGLONG last_tick, last_transfer, last_pts;
+
+    if (!p->window_start)
+    {
+        p->window_start = now;
+        return;
+    }
+
+    if (now - p->window_start < 1000000)
+        return;
+
+    if (engine->presentation.frame_sink)
+        video_frame_sink_get_stats(engine->presentation.frame_sink, &frames_in, &queued);
+
+    wine_dbg_printf("mfme-prof %p: window %uus | tick: n=%u with_frame=%u gap_max=%uus cs_wait_max=%uus"
+            " | transfer: n=%u new=%u repeat=%u fast=%u avg=%uus max=%uus gap_max=%uus cs_wait_max=%uus"
+            " dev_wait_max=%uus | upload: n=%u avg=%uus max=%uus | gpu(transfer): n=%u avg=%uus max=%uus skipped=%u"
+            " | sink: frames_in=%u queued=%u\n",
+            engine, (unsigned int)(now - p->window_start), p->ticks, p->ticks_with_frame,
+            (unsigned int)p->tick_gap_max, (unsigned int)p->tick_cs_wait_max,
+            p->transfers, p->transfers_new, p->transfers_repeat, p->transfers_fast,
+            (unsigned int)(p->transfers ? p->transfer_total / p->transfers : 0), (unsigned int)p->transfer_max,
+            (unsigned int)p->transfer_gap_max, (unsigned int)p->transfer_cs_wait_max,
+            (unsigned int)p->device_wait_max,
+            p->uploads, (unsigned int)(p->uploads ? p->upload_total / p->uploads : 0),
+            (unsigned int)p->upload_max,
+            p->gpu_n, (unsigned int)(p->gpu_n ? p->gpu_total / p->gpu_n : 0), (unsigned int)p->gpu_max,
+            p->gpu_skipped, frames_in, queued);
+
+    last_tick = p->last_tick;
+    last_transfer = p->last_transfer;
+    last_pts = p->last_pts;
+    memset(p, 0, sizeof(*p));
+    p->window_start = now;
+    p->last_tick = last_tick;
+    p->last_transfer = last_transfer;
+    p->last_pts = last_pts;
+}
+
+/* Called whenever a frame is fetched from the sink for a transfer. Tells whether it is a new or a repeated frame. */
+static void media_engine_profile_note_sample(struct media_engine *engine, IMFSample *sample, BOOL fast)
+{
+    struct media_engine_profile *p = &engine->profile;
+    LONGLONG pts;
+
+    if (!media_engine_profile_enabled())
+        return;
+
+    p->cur_fast = fast;
+    p->cur_seen = TRUE;
+    if (SUCCEEDED(IMFSample_GetSampleTime(sample, &pts)))
+    {
+        p->cur_new = pts != p->last_pts;
+        p->last_pts = pts;
+    }
+    else
+        p->cur_new = TRUE;
+}
+
+static void media_engine_profile_transfer_done(struct media_engine *engine, LONGLONG start, LONGLONG end,
+        LONGLONG cs_wait)
+{
+    struct media_engine_profile *p = &engine->profile;
+    LONGLONG duration = end - start;
+
+    p->transfers++;
+    if (p->cur_seen)
+    {
+        if (p->cur_new)
+            p->transfers_new++;
+        else
+            p->transfers_repeat++;
+        if (p->cur_fast)
+            p->transfers_fast++;
+    }
+    p->transfer_total += duration;
+    p->transfer_max = max(p->transfer_max, duration);
+    p->transfer_cs_wait_max = max(p->transfer_cs_wait_max, cs_wait);
+    if (p->last_transfer)
+        p->transfer_gap_max = max(p->transfer_gap_max, start - p->last_transfer);
+    p->last_transfer = start;
+
+    media_engine_profile_flush(engine, end);
+}
+
+static void media_engine_profile_tick_done(struct media_engine *engine, LONGLONG now, LONGLONG cs_wait,
+        BOOL with_frame)
+{
+    struct media_engine_profile *p = &engine->profile;
+
+    p->ticks++;
+    if (with_frame)
+        p->ticks_with_frame++;
+    p->tick_cs_wait_max = max(p->tick_cs_wait_max, cs_wait);
+    if (p->last_tick)
+        p->tick_gap_max = max(p->tick_gap_max, now - p->last_tick);
+    p->last_tick = now;
+
+    media_engine_profile_flush(engine, now);
+}
+
+static void media_engine_release_gpu_timing(struct media_engine *engine)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(engine->gpu_timing); ++i)
+    {
+        struct media_engine_gpu_timing *timing = &engine->gpu_timing[i];
+
+        if (timing->disjoint)
+            ID3D11Query_Release(timing->disjoint);
+        if (timing->start)
+            ID3D11Query_Release(timing->start);
+        if (timing->end)
+            ID3D11Query_Release(timing->end);
+    }
+    memset(engine->gpu_timing, 0, sizeof(engine->gpu_timing));
+    engine->gpu_timing_next = 0;
+}
+
+/* Reads back a finished measurement. Returns FALSE if the GPU has not got there yet. */
+static BOOL media_engine_gpu_timing_collect(struct media_engine *engine, ID3D11DeviceContext *context,
+        struct media_engine_gpu_timing *timing)
+{
+    D3D11_QUERY_DATA_TIMESTAMP_DISJOINT disjoint;
+    struct media_engine_profile *p = &engine->profile;
+    UINT64 start, end;
+    LONGLONG duration;
+
+    if (ID3D11DeviceContext_GetData(context, (ID3D11Asynchronous *)timing->disjoint, &disjoint, sizeof(disjoint),
+            D3D11_ASYNC_GETDATA_DONOTFLUSH) != S_OK)
+        return FALSE;
+
+    timing->pending = FALSE;
+    if (disjoint.Disjoint || !disjoint.Frequency
+            || ID3D11DeviceContext_GetData(context, (ID3D11Asynchronous *)timing->start, &start, sizeof(start), 0) != S_OK
+            || ID3D11DeviceContext_GetData(context, (ID3D11Asynchronous *)timing->end, &end, sizeof(end), 0) != S_OK)
+        return TRUE;
+
+    duration = (end - start) * 1000000 / disjoint.Frequency;
+    p->gpu_n++;
+    p->gpu_total += duration;
+    p->gpu_max = max(p->gpu_max, duration);
+    return TRUE;
+}
+
+/* Starts measuring how long the GPU takes to execute the commands issued until media_engine_gpu_timing_end(), using
+ * timestamp queries. Results are collected on later transfers so that this never waits for the GPU. */
+static struct media_engine_gpu_timing *media_engine_gpu_timing_begin(struct media_engine *engine,
+        ID3D11Device *device, ID3D11DeviceContext *context)
+{
+    struct media_engine_gpu_timing *timing;
+    D3D11_QUERY_DESC desc = {0};
+
+    if (!media_engine_profile_enabled())
+        return NULL;
+
+    timing = &engine->gpu_timing[engine->gpu_timing_next];
+    engine->gpu_timing_next = (engine->gpu_timing_next + 1) % ARRAY_SIZE(engine->gpu_timing);
+
+    if (timing->pending && !media_engine_gpu_timing_collect(engine, context, timing))
+    {
+        engine->profile.gpu_skipped++;
+        return NULL;
+    }
+
+    if (!timing->disjoint)
+    {
+        desc.Query = D3D11_QUERY_TIMESTAMP_DISJOINT;
+        if (FAILED(ID3D11Device_CreateQuery(device, &desc, &timing->disjoint)))
+            return NULL;
+        desc.Query = D3D11_QUERY_TIMESTAMP;
+        if (FAILED(ID3D11Device_CreateQuery(device, &desc, &timing->start))
+                || FAILED(ID3D11Device_CreateQuery(device, &desc, &timing->end)))
+        {
+            ID3D11Query_Release(timing->disjoint);
+            if (timing->start)
+                ID3D11Query_Release(timing->start);
+            memset(timing, 0, sizeof(*timing));
+            return NULL;
+        }
+    }
+
+    ID3D11DeviceContext_Begin(context, (ID3D11Asynchronous *)timing->disjoint);
+    ID3D11DeviceContext_End(context, (ID3D11Asynchronous *)timing->start);
+    return timing;
+}
+
+static void media_engine_gpu_timing_end(ID3D11DeviceContext *context, struct media_engine_gpu_timing *timing)
+{
+    if (!timing)
+        return;
+
+    ID3D11DeviceContext_End(context, (ID3D11Asynchronous *)timing->end);
+    ID3D11DeviceContext_End(context, (ID3D11Asynchronous *)timing->disjoint);
+    timing->pending = TRUE;
+}
+
+/* Logs the source and destination textures of a transfer, whenever they change. */
+static void media_engine_profile_log_textures(struct media_engine *engine, const char *path,
+        const D3D11_TEXTURE2D_DESC *src, ID3D11Texture2D *dst_texture, const D3D11_TEXTURE2D_DESC *dst)
+{
+    if (!media_engine_profile_enabled())
+        return;
+
+    if (engine->logged_textures.valid && engine->logged_textures.dst == dst_texture
+            && !memcmp(&engine->logged_textures.src_desc, src, sizeof(*src))
+            && !memcmp(&engine->logged_textures.dst_desc, dst, sizeof(*dst)))
+        return;
+
+    engine->logged_textures.valid = TRUE;
+    engine->logged_textures.dst = dst_texture;
+    engine->logged_textures.src_desc = *src;
+    engine->logged_textures.dst_desc = *dst;
+
+    wine_dbg_printf("mfme-prof %p: %s transfer | src %ux%u fmt=%u usage=%u bind=%#x cpu=%#x misc=%#x mips=%u"
+            " array=%u samples=%u | dst %p %ux%u fmt=%u usage=%u bind=%#x cpu=%#x misc=%#x mips=%u array=%u"
+            " samples=%u\n", engine, path,
+            src->Width, src->Height, src->Format, src->Usage, src->BindFlags, src->CPUAccessFlags, src->MiscFlags,
+            src->MipLevels, src->ArraySize, src->SampleDesc.Count,
+            dst_texture, dst->Width, dst->Height, dst->Format, dst->Usage, dst->BindFlags, dst->CPUAccessFlags,
+            dst->MiscFlags, dst->MipLevels, dst->ArraySize, dst->SampleDesc.Count);
+}
